rules_version = '2';

// ═══════════════════════════════════════════════
// REXMOTO — Firestore Security Rules
// ═══════════════════════════════════════════════
// الزائر: يقرأ المنتجات المتاحة والإعدادات والتقييمات الموافق عليها فقط
// الزائر: ينشئ طلباً جديداً أو تقييماً جديداً فقط (لا يقرأ طلبات الآخرين)
// المدير (مصادَق عليه): كل الصلاحيات
// ═══════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال مساعدة ──
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }

    function isValidOrder() {
      let d = request.resource.data;
      return d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 80
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.productId is string && d.productId.size() > 0
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 20
        && (!has(d, 'notes') || (d.notes is string && d.notes.size() <= 500))
        && (!has(d, 'selectedColor') || (d.selectedColor is string && d.selectedColor.size() <= 30))
        && (!has(d, 'city') || (d.city is string && d.city.size() <= 60))
        && d.status == 'new';
    }

    function isValidTestimonial() {
      let d = request.resource.data;
      return d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 60
        && d.comment is string && d.comment.size() >= 3 && d.comment.size() <= 1000
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.status == 'pending';
    }

    // ── الإعدادات العامة ──
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── المنتجات ──
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ── الطلبات ──
    match /orders/{orderId} {
      allow read: if isStaff();
      allow create: if isValidOrder();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── التقييمات ──
    match /testimonials/{tId} {
      allow read: if resource.data.status == 'approved' || isStaff();
      allow create: if isValidTestimonial();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // ── المشرفون ──
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // تُدار من Firebase Console فقط
    }
  }
}
